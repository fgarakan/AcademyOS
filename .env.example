# ============================================================
# ACADEMY OS — ENVIRONMENT VARIABLES
# Copy this file to .env.local for development.
# Never commit .env.local to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-side admin only; never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Supabase CLI (for running migrations) ────────────────────
# Set via: supabase link --project-ref your-project-id
# Or set SUPABASE_DB_PASSWORD directly for psql migrations

SUPABASE_PROJECT_REF=your-project-id
SUPABASE_DB_PASSWORD=your-database-password

# ── Anthropic (Claude API) ───────────────────────────────────
# Get from: https://console.anthropic.com

ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Application ──────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
