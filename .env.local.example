NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DONNA Executive Operating Layer — tri-state: off (default) | shadow | primary.
# `primary` runs the executive reasoning pipeline (OpenAI) as DONNA's live brain;
# legacy remains the certified fail-open fallback. Set BOTH to the same value:
# the server reads DONNA_EXECUTIVE_REASONING; the client-bundled brain router reads
# the NEXT_PUBLIC_ mirror to engage executive-first routing in the live UI.
# DONNA_EXECUTIVE_REASONING=primary
# NEXT_PUBLIC_DONNA_EXECUTIVE_REASONING=primary
# OPENAI_API_KEY=sk-...   # required for real executive reasoning (else fail-open)
