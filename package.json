{
  "name": "academy-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "guard": "tsx src/lib/guardians/runGuardians.ts",
    "certify": "tsx scripts/runCertifications.ts",
    "test:tenant-isolation": "node --env-file=.env.local --import tsx scripts/certification/tenantIsolationBehavioralTest.ts",
    "demo:seed": "node --env-file=.env.local --import tsx scripts/demo/seed.ts",
    "demo:reset": "node --env-file=.env.local --import tsx scripts/demo/reset.ts",
    "certify:model": "node --import tsx src/lib/donna/certification/modelSafetyCertification.ts && node --import tsx src/lib/donna/certification/modelAssistedGuidanceCertification.ts",
    "test:llm-smoke": "node --import tsx src/lib/donna/certification/liveLlmSmokeTest.ts",
    "ci": "npm run type-check && npm run guard && npm run certify && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.4",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.460.0",
    "next": "14.2.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "14.2.29",
    "postcss": "^8",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
